
<Window x:Class="BuildCalc.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Инженерный Калькулятор 5-в-1" Height="500" Width="550"
        Background="#F4F4F9">
    <Grid Margin="10">
        <TabControl Background="White" BorderBrush="#DADADA">

            <!-- Вкладка 1: Линолеум / Плинтус -->
            <TabItem Header="Линолеум/Плинтус">
                <StackPanel Margin="20">
                    <TextBlock Text="Расчет погонных метров" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
                    <TextBlock Text="Площадь комнаты (м²):"/>
                    <TextBox x:Name="txtArea" Margin="0,5,0,10" Padding="5"/>
                    <TextBlock Text="Ширина материала (м):"/>
                    <TextBox x:Name="txtMatWidth" Margin="0,5,0,15" Padding="5"/>
                    <Button Content="Рассчитать" Height="35"
                            Background="#34495E" Foreground="White"
                            Click="CalculateLinoleum_Click"/>
                    <Separator Margin="0,15,0,10"/>
                    <TextBlock Text="Результат:" Margin="0,0,0,5"/>
                    <TextBlock x:Name="txtLinoleumResult" FontSize="28" FontWeight="Bold" Foreground="#8E44AD"/>
                </StackPanel>
            </TabItem>

            <!-- Вкладка 2: Плитка -->
            <TabItem Header="Плитка">
                <StackPanel Margin="20">
                    <TextBlock Text="Расчет упаковок плитки (+10%)" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
                    <TextBlock Text="Площадь укладки (м²):"/>
                    <TextBox x:Name="txtTileArea" Margin="0,5,0,10" Padding="5"
                             TextChanged="CalculateTile_Changed"/>
                    <TextBlock Text="М² в одной упаковке:"/>
                    <TextBox x:Name="txtPackageSize" Margin="0,5,0,15" Padding="5"
                             TextChanged="CalculateTile_Changed"/>
                    <Separator/>
                    <TextBlock Text="Нужно упаковок:" Margin="0,10,0,0"/>
                    <TextBlock x:Name="txtTotalPackages" FontSize="36" FontWeight="Bold" Foreground="#27AE60"/>
                </StackPanel>
            </TabItem>

            <!-- Вкладка 3: Бетон -->
            <TabItem Header="Бетон">
                <StackPanel Margin="20">
                    <TextBlock Text="Объем бетона для фундамента" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
                    <TextBlock Text="Длина (м):"/>
                    <TextBox x:Name="txtL" Margin="0,5,0,10" Padding="5"/>
                    <TextBlock Text="Ширина (м):"/>
                    <TextBox x:Name="txtW" Margin="0,5,0,10" Padding="5"/>
                    <TextBlock Text="Глубина/Толщина (м):"/>
                    <TextBox x:Name="txtD" Margin="0,5,0,15" Padding="5"/>
                    <Button Content="Рассчитать объем" Height="35"
                            Background="#2980B9" Foreground="White"
                            Click="CalculateConcrete_Click"/>
                    <Separator Margin="0,15,0,10"/>
                    <TextBlock Text="Результат:" Margin="0,0,0,5"/>
                    <TextBlock x:Name="txtConcreteResult" FontSize="28" FontWeight="Bold" Foreground="#2980B9"/>
                </StackPanel>
            </TabItem>

            <!-- Вкладка 4: Кровля -->
            <TabItem Header="Кровля">
                <StackPanel Margin="20">
                    <TextBlock Text="Расчет длины стропил" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
                    <TextBlock Text="Горизонтальная проекция (м):"/>
                    <TextBox x:Name="txtProjection" Margin="0,5,0,10" Padding="5"/>
                    <TextBlock Text="Угол наклона крыши (градусы):"/>
                    <TextBox x:Name="txtAngle" Margin="0,5,0,15" Padding="5"/>
                    <Button Content="Рассчитать длину" Height="35"
                            Background="#C0392B"
                            Foreground="White"
                            Click="CalculateRafters_Click"/>
                    <Separator Margin="0,15,0,10"/>
                    <TextBlock Text="Результат:" Margin="0,0,0,5"/>
                    <TextBlock x:Name="txtRaftersResult" FontSize="28" FontWeight="Bold" Foreground="#C0392B"/>
                </StackPanel>
            </TabItem>

        </TabControl>
    </Grid>
</Window>