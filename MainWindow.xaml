<Window x:Class="plug.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:plug"
        mc:Ignorable="d"
        Title="Строительный Калькулятор" Height="520" Width="560"
        Background="#F4F4F9">
    <Grid Margin="10">
        <TabControl Background="White" BorderBrush="#DADADA">

            <TabItem Header="Линолеум">
                <StackPanel Margin="20" DataContext="{Binding Linoleum}">
                    <TextBlock Text="Погонные метры" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
                    <TextBlock Text="Площадь комнаты (м²):"/>
                    <TextBox Text="{Binding Area, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,10" Padding="5"/>
                    <TextBlock Text="Ширина материала (м):"/>
                    <TextBox Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,15" Padding="5"/>
                    <Separator/>
                    <TextBlock Text="Результат:" Margin="0,10,0,5"/>
                    <TextBlock Text="{Binding LinearMeters}" FontSize="32" FontWeight="Bold" Foreground="#8E44AD"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Стены">
                <StackPanel Margin="20" DataContext="{Binding Wall}">
                    <TextBlock Text="Площадь стен" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
                    <TextBlock Text="Длина комнаты (м):"/>
                    <TextBox Text="{Binding Length, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,10" Padding="5"/>
                    <TextBlock Text="Ширина комнаты (м):"/>
                    <TextBox Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,10" Padding="5"/>
                    <TextBlock Text="Высота стен (м):"/>
                    <TextBox Text="{Binding Height, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,10" Padding="5"/>
                    <TextBlock Text="Площадь проёмов (м²):"/>
                    <TextBox Text="{Binding OpeningsArea, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,15" Padding="5"/>
                    <Separator/>
                    <TextBlock Text="Результат:" Margin="0,10,0,5"/>
                    <TextBlock Text="{Binding WallAreaResult}" FontSize="32" FontWeight="Bold" Foreground="#E67E22"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Бетон">
                <StackPanel Margin="20" DataContext="{Binding Concrete}">
                    <TextBlock Text="Объём бетона (плита)" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
                    <TextBlock Text="Длина (м):"/>
                    <TextBox Text="{Binding Length, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,10" Padding="5"/>
                    <TextBlock Text="Ширина (м):"/>
                    <TextBox Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,10" Padding="5"/>
                    <TextBlock Text="Глубина/Толщина (м):"/>
                    <TextBox Text="{Binding Depth, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,15" Padding="5"/>
                    <Separator/>
                    <TextBlock Text="Результат:" Margin="0,10,0,5"/>
                    <TextBlock Text="{Binding ConcreteVolume}" FontSize="32" FontWeight="Bold" Foreground="#2980B9"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Плитка">
                <StackPanel Margin="20" DataContext="{Binding Tile}">
                    <TextBlock Text="Расчёт упаковок (+10%)" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
                    <TextBlock Text="Площадь укладки (м²):"/>
                    <TextBox Text="{Binding Area, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,10" Padding="5"/>
                    <TextBlock Text="М² в одной упаковке:"/>
                    <TextBox Text="{Binding M2InPackage, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,15" Padding="5"/>
                    <Separator/>
                    <TextBlock Text="Результат:" Margin="0,10,0,5"/>
                    <TextBlock Text="{Binding TotalPackages}" FontSize="32" FontWeight="Bold" Foreground="#27AE60"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Кровля">
                <StackPanel Margin="20" DataContext="{Binding Rafter}">
                    <TextBlock Text="Длина стропил" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
                    <TextBlock Text="Горизонтальная проекция (м):"/>
                    <TextBox Text="{Binding HorizontalProjection, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,10" Padding="5"/>
                    <TextBlock Text="Угол наклона (градусы):"/>
                    <TextBox Text="{Binding AngleDegrees, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,15" Padding="5"/>
                    <Separator/>
                    <TextBlock Text="Результат:" Margin="0,10,0,5"/>
                    <TextBlock Text="{Binding RafterLength}" FontSize="32" FontWeight="Bold" Foreground="#C0392B"/>
                </StackPanel>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
