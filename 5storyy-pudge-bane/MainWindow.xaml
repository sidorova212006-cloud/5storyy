<Window x:Class="plug.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:plug"
        mc:Ignorable="d"
        Title="Инженерный калькулятор" Height="560" Width="640"
        Background="#F4F4F9">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="170" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Background="White" BorderBrush="#DADADA">
            <!-- 1) Линолеум -->
            <TabItem Header="Линолеум">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20" VerticalAlignment="Top">
                        <TextBlock Text="Расчёт расхода линолеума" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,14"/>

                        <Grid Margin="0,0,0,8" MinWidth="520">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Площадь (S), м²" VerticalAlignment="Center" Margin="0,4"/>
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Text="{Binding LinoleumArea, UpdateSourceTrigger=PropertyChanged}"
                                     Height="28" Margin="0,4,0,0"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Ширина рулона (b), м" VerticalAlignment="Center" Margin="0,4"/>
                            <TextBox Grid.Row="1" Grid.Column="1"
                                     Text="{Binding LinoleumWidth, UpdateSourceTrigger=PropertyChanged}"
                                     Height="28" Margin="0,4,0,0"/>
                        </Grid>

                        <Button Content="Посчитать"
                                Width="140"
                                Height="32"
                                HorizontalAlignment="Left"
                                Command="{Binding CalculateLinoleumCommand}" />

                        <TextBlock Text="Результат:"
                                   Margin="0,14,0,4"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="{Binding LinoleumResult}"
                                   FontSize="14" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 2) Стены -->
            <TabItem Header="Стены">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20" VerticalAlignment="Top">
                        <TextBlock Text="Расчёт площади стен" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,14"/>

                        <Grid Margin="0,0,0,8" MinWidth="520">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Длина (L), м" VerticalAlignment="Center" Margin="0,4"/>
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Text="{Binding WallLength, UpdateSourceTrigger=PropertyChanged}"
                                     Height="28" Margin="0,4,0,0"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Ширина (W), м" VerticalAlignment="Center" Margin="0,4"/>
                            <TextBox Grid.Row="1" Grid.Column="1"
                                     Text="{Binding WallWidth, UpdateSourceTrigger=PropertyChanged}"
                                     Height="28" Margin="0,4,0,0"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Высота (H), м" VerticalAlignment="Center" Margin="0,4"/>
                            <TextBox Grid.Row="2" Grid.Column="1"
                                     Text="{Binding WallHeight, UpdateSourceTrigger=PropertyChanged}"
                                     Height="28" Margin="0,4,0,0"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Проёмы (A), м²" VerticalAlignment="Center" Margin="0,4"/>
                            <TextBox Grid.Row="3" Grid.Column="1"
                                     Text="{Binding WallOpeningsArea, UpdateSourceTrigger=PropertyChanged}"
                                     Height="28" Margin="0,4,0,0"/>
                        </Grid>

                        <Button Content="Посчитать"
                                Width="140"
                                Height="32"
                                HorizontalAlignment="Left"
                                Command="{Binding CalculateWallsCommand}" />

                        <TextBlock Text="Результат:"
                                   Margin="0,14,0,4"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="{Binding WallAreaResult}"
                                   FontSize="14" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 3) Бетон -->
            <TabItem Header="Бетон">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20" VerticalAlignment="Top">
                        <TextBlock Text="Расчёт объёма бетона" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,14"/>

                        <Grid Margin="0,0,0,8" MinWidth="520">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Длина (a), м" VerticalAlignment="Center" Margin="0,4"/>
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Text="{Binding ConcreteLength, UpdateSourceTrigger=PropertyChanged}"
                                     Height="28" Margin="0,4,0,0"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Ширина (b), м" VerticalAlignment="Center" Margin="0,4"/>
                            <TextBox Grid.Row="1" Grid.Column="1"
                                     Text="{Binding ConcreteWidth, UpdateSourceTrigger=PropertyChanged}"
                                     Height="28" Margin="0,4,0,0"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Толщина (h), м" VerticalAlignment="Center" Margin="0,4"/>
                            <TextBox Grid.Row="2" Grid.Column="1"
                                     Text="{Binding ConcreteDepth, UpdateSourceTrigger=PropertyChanged}"
                                     Height="28" Margin="0,4,0,0"/>
                        </Grid>

                        <Button Content="Посчитать"
                                Width="140"
                                Height="32"
                                HorizontalAlignment="Left"
                                Command="{Binding CalculateConcreteCommand}" />

                        <TextBlock Text="Результат:"
                                   Margin="0,14,0,4"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="{Binding ConcreteVolumeResult}"
                                   FontSize="14" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 4) Плитка -->
            <TabItem Header="Плитка">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20" VerticalAlignment="Top">
                        <TextBlock Text="Расчёт количества плитки (в упаковках)" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,14"/>

                        <Grid Margin="0,0,0,8" MinWidth="520">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Площадь (S), м²" VerticalAlignment="Center" Margin="0,4"/>
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Text="{Binding TileArea, UpdateSourceTrigger=PropertyChanged}"
                                     Height="28" Margin="0,4,0,0"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Площадь в упаковке (m²)" VerticalAlignment="Center" Margin="0,4"/>
                            <TextBox Grid.Row="1" Grid.Column="1"
                                     Text="{Binding TileM2InPackage, UpdateSourceTrigger=PropertyChanged}"
                                     Height="28" Margin="0,4,0,0"/>
                        </Grid>

                        <Button Content="Посчитать"
                                Width="140"
                                Height="32"
                                HorizontalAlignment="Left"
                                Command="{Binding CalculateTileCommand}" />

                        <TextBlock Text="Результат:"
                                   Margin="0,14,0,4"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="{Binding TilePackagesResult}"
                                   FontSize="14" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 5) Стропило -->
            <TabItem Header="Стропило">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20" VerticalAlignment="Top">
                        <TextBlock Text="Расчёт длины стропила" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,14"/>

                        <Grid Margin="0,0,0,8" MinWidth="520">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Проекция (p), м" VerticalAlignment="Center" Margin="0,4"/>
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Text="{Binding RafterProjection, UpdateSourceTrigger=PropertyChanged}"
                                     Height="28" Margin="0,4,0,0"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Угол (α), градусы" VerticalAlignment="Center" Margin="0,4"/>
                            <TextBox Grid.Row="1" Grid.Column="1"
                                     Text="{Binding RafterAngleDegrees, UpdateSourceTrigger=PropertyChanged}"
                                     Height="28" Margin="0,4,0,0"/>
                        </Grid>

                        <Button Content="Посчитать"
                                Width="140"
                                Height="32"
                                HorizontalAlignment="Left"
                                Command="{Binding CalculateRafterCommand}" />

                        <TextBlock Text="Результат:"
                                   Margin="0,14,0,4"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="{Binding RafterLengthResult}"
                                   FontSize="14" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- History -->
        <Border Grid.Row="1" Background="White" BorderBrush="#DADADA" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,10,0,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <DockPanel>
                        <TextBlock Text="История расчётов" FontWeight="SemiBold" FontSize="14" DockPanel.Dock="Left"/>
                        <Button Content="Очистить"
                                Width="110"
                                Height="28"
                                DockPanel.Dock="Right"
                                Command="{Binding ClearHistoryCommand}" />
                    </DockPanel>
                </StackPanel>

                <TextBox Text="{Binding History, Mode=OneWay}"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         FontFamily="Consolas"
                         FontSize="12" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
